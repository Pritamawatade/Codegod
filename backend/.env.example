PORT=8080

CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:8080

# Host machine (Prisma CLI, npm run dev). Port must match docker-compose HOST_POSTGRES_PORT (default 5433).
HOST_POSTGRES_PORT=5433
# Must use the same POSTGRES_* credentials as docker-compose postgres service.
DATABASE_URL=postgresql://postgres:password@localhost:5433/codegod

JWT_SECRET=

JUDGE0_API_URL=http://localhost:2358
JUDGE0_API_KEY=
JUDGE0_POSTGRES_USER=judge0
JUDGE0_POSTGRES_PASSWORD=judge0
REDIS_PASSWORD=judge0redis
JUDGE0_AUTH_TOKEN=

# Leave empty for local dev. If unset or invalid, Cloudinary is skipped at startup.
# Real format: cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=1d

MAILTRAP_HOST=
MAILTRAP_PORT=
MAILTRAP_USERNAME=
MAILTRAP_PASSWORD=
MAILTRAP_SENDEREMAIL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_URL=http://localhost:5173

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
